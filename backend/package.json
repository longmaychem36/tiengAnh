{
  "name": "english-learning-system-api",
  "version": "1.0.0",
  "description": "Backend API for English Learning System",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "dev:all": "concurrently \"npm run dev\" \"python whisper_server.py\"",
    "db:migrate-minigames": "node scripts/migrate_minigames.js",
    "db:migrate-receptive": "node scripts/migrate_receptive_courses.js",
    "db:import-data": "node scripts/import_dump_data.js",
    "db:import-data:check": "node scripts/import_dump_data.js --dry-run",
    "db:counts": "node scripts/db_counts.js",
    "db:migrate-collections": "node scripts/migrate_collections.js",
    "db:migrate-onboarding": "node scripts/migrate_onboarding.js",
    "db:seed-receptive": "npm run db:migrate-receptive && node scripts/seed_receptive_courses.js",
    "db:seed-vocabulary": "node scripts/seed_vocabulary.js",
    "db:seed-onboarding": "node scripts/seed_onboarding_content.js",
    "db:seed-leaderboard-demo": "node scripts/seed_leaderboard_demo.js"
  },
  "keywords": [
    "english",
    "learning",
    "api",
    "education"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.15.2",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-validator": "^7.2.0",
    "form-data": "^4.0.5",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.20.0",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "nodemon": "^3.1.4"
  }
}
