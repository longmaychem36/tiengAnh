# Server
PORT=5000
NODE_ENV=development

# PostgreSQL Database
DB_HOST=localhost
DB_NAME=EnglishLearningSystem
DB_USER=postgres
DB_PASSWORD=
DB_PORT=5432
DB_SSL=false

# JWT
JWT_SECRET=
JWT_EXPIRES_IN=7d

# OpenAI generation
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
SPEAKING_OPENAI_MODEL=gpt-4o-mini
SPEAKING_AI_TIMEOUT_MS=60000
WRITING_OPENAI_MODEL=gpt-4o-mini
WRITING_AI_ENABLED=true
WRITING_AI_TIMEOUT_MS=6000
WRITING_AI_MAX_TOKENS=280
WRITING_FAST_PASS_SCORE=92
WRITING_FAST_FAIL_SCORE=45
WRITING_CHECK_CACHE_TTL_MS=600000
WRITING_CHECK_CACHE_MAX=500

# Cloudinary avatar uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Whisper Server (Speech Recognition)
# Local: http://127.0.0.1:5001
# Production: https://your-whisper-service.onrender.com
WHISPER_SERVER_URL=http://127.0.0.1:5001
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE=int8
WHISPER_PORT=5001

# Plus billing
PLUS_PRICE_VND=2000
PLUS_DURATION_DAYS=30

# SePay bank transfer integration
# Webhook URL in SePay dashboard: https://your-domain.com/api/v1/billing/sepay/webhook
SEPAY_BANK_CODE=
SEPAY_ACCOUNT_NUMBER=
SEPAY_ACCOUNT_NAME=
SEPAY_WEBHOOK_API_KEY=
SEPAY_API_TOKEN=




# File Uploads
UPLOAD_DIR=./uploads
MAX_IMAGE_SIZE=5242880
MAX_AUDIO_SIZE=10485760

# Client
CLIENT_URL=http://localhost:5173

# Password reset email (SMTP)
APP_NAME=LingoConnect
MAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_TIMEOUT_MS=20000
