# Server
PORT=5000
NODE_ENV=development

# SQL Server Database
DB_SERVER=localhost
DB_NAME=EnglishLearningSystem
DB_USER=sa
DB_PASSWORD=
DB_PORT=1433
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true

# JWT
JWT_SECRET=
JWT_EXPIRES_IN=7d

# NVIDIA NIM AI generation
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.3-70b-instruct

# Whisper Server (Speech Recognition)
WHISPER_SERVER_URL=http://127.0.0.1:5001
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE=int8

# Plus billing
PLUS_PRICE_VND=2000
PLUS_DURATION_DAYS=30

# SePay bank transfer integration
# Webhook URL in SePay dashboard: https://your-domain.com/api/v1/billing/sepay/webhook
SEPAY_BANK_CODE=
SEPAY_ACCOUNT_NUMBER=
SEPAY_ACCOUNT_NAME=
SEPAY_WEBHOOK_API_KEY=
SEPAY_API_TOKEN=




# File Uploads
UPLOAD_DIR=./uploads
MAX_IMAGE_SIZE=5242880
MAX_AUDIO_SIZE=10485760

# Client
CLIENT_URL=http://localhost:5173
