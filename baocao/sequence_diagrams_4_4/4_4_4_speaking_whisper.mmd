%%{init: {"theme":"base","themeVariables":{"fontFamily":"Arial","fontSize":"22px","actorFontSize":"22px","messageFontSize":"20px","noteFontSize":"20px"},"sequence":{"actorMargin":110,"messageMargin":65,"diagramMarginX":45,"diagramMarginY":25}}}%%
sequenceDiagram
    autonumber
    actor Learner as Learner
    participant FE as React Frontend<br/>(Speaking Lesson)
    participant Media as Browser MediaRecorder
    participant BE as Node.js/Express Backend<br/>(Speaking Module)
    participant Whisper as Flask Whisper<br/>(faster-whisper)
    participant DB as PostgreSQL

    rect rgb(245, 248, 255)
    Note over Learner,DB: Phase 1 - Load Plus Speaking lesson
    Learner->>FE: Open Speaking lesson
    FE->>BE: GET /api/v1/speaking/lessons or /lessons/:id
    BE->>BE: Verify JWT, learner role and Plus plan
    BE->>DB: Select plan, lessons and speaking questions
    DB-->>BE: Lesson and sentences
    BE-->>FE: 200 lesson detail
    FE-->>Learner: Show prompts and sample answers
    end

    rect rgb(248, 255, 246)
    Note over Learner,Whisper: Phase 2 - Record audio and analyze pronunciation
    Learner->>FE: Start recording
    FE->>Media: Request microphone and start recording
    Media-->>FE: WebM audio chunks
    Learner->>FE: Stop recording
    FE->>Media: Build audio Blob
    FE->>BE: POST /api/v1/speaking/transcribe-analyze
    BE->>BE: Validate upload and build Whisper prompt
    alt Missing file or unsupported format
        BE-->>FE: 400 audio upload error
        FE-->>Learner: Show recording error
    else Valid audio
        BE->>Whisper: POST /transcribe-and-analyze with audio file
        alt Whisper offline, timeout or error
            Whisper--xBE: Error response
            BE->>BE: Delete temporary audio file
            BE-->>FE: 500 speech service unavailable
            FE-->>Learner: Show speech recognition error
        else Whisper succeeds
            Whisper-->>BE: Transcript and processing time
            BE->>BE: Run fuzzy alignment against target texts
            BE->>BE: Delete temporary audio file
            BE-->>FE: 200 transcript, score and feedback
            FE-->>Learner: Show pronunciation feedback
        end
    end
    end

    rect rgb(255, 250, 240)
    Note over Learner,DB: Phase 3 - Save Speaking progress
    Learner->>FE: Finish all speaking items
    FE->>BE: POST /api/v1/speaking/progress
    BE->>DB: Upsert SpeakingProgress
    alt First completion
        BE->>DB: Update UserStats with Speaking EXP
        BE->>DB: Complete matching DailyTasks
    else Already completed before
        BE->>BE: Skip duplicate EXP reward
    end
    BE-->>FE: 200 progress saved
    FE-->>Learner: Show lesson completion
    end
