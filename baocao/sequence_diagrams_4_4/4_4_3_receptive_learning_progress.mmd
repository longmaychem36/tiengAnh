%%{init: {"theme":"base","themeVariables":{"fontFamily":"Arial","fontSize":"22px","actorFontSize":"22px","messageFontSize":"20px","noteFontSize":"20px"},"sequence":{"actorMargin":110,"messageMargin":65,"diagramMarginX":45,"diagramMarginY":25}}}%%
sequenceDiagram
    autonumber
    actor Learner as Learner
    participant FE as React Frontend<br/>(Skill Lesson UI)
    participant BE as Node.js/Express Backend<br/>(Listening Reading Writing)
    participant DB as PostgreSQL

    rect rgb(245, 248, 255)
    Note over Learner,DB: Phase 1 - Load Listening, Reading or Writing lessons
    Learner->>FE: Open a skill course
    FE->>BE: GET /api/v1/listening, reading or writing lessons
    BE->>BE: Verify JWT and learner role
    alt Listening requires Plus and account is not active Plus
        BE->>DB: Read Plan and PlusExpiresAt
        DB-->>BE: Free or expired plan
        BE-->>FE: 403 Plus required
        FE-->>Learner: Redirect to upgrade screen
    else Request is allowed
        BE->>DB: Read placement level, lessons, item counts and progress
        DB-->>BE: Lessons with progress
        BE->>BE: Hide foundation lessons for basic placement and apply sequence locks
        BE-->>FE: 200 lesson list with lock and completion state
        FE-->>Learner: Show available lessons
    end
    end

    rect rgb(248, 255, 246)
    Note over Learner,DB: Phase 2 - Load lesson detail
    Learner->>FE: Select an unlocked lesson
    FE->>BE: GET /api/v1/skill/lessons/:id
    BE->>DB: Select lesson and verify placement visibility
    alt Lesson is missing or hidden
        BE-->>FE: 400 or 404 lesson not found
        FE-->>Learner: Show loading error
    else Lesson is available
        par Listening detail
            BE->>DB: Select speakers, segments, questions and vocabulary
        and Reading detail
            BE->>DB: Select paragraphs, questions and vocabulary
        and Writing detail
            BE->>DB: Select exercises and writing vocabulary
        end
        DB-->>BE: Lesson detail payload
        BE-->>FE: 200 content, questions or exercises
        FE-->>Learner: Render practice screen
    end
    end

    rect rgb(255, 250, 240)
    Note over Learner,DB: Phase 3 - Finish practice and save progress
    loop Each question or exercise
        Learner->>FE: Answer current item
        FE->>FE: Check objective answers or call Writing check when needed
    end
    Learner->>FE: Click Finish
    FE->>BE: POST /api/v1/skill/progress
    BE->>DB: Read existing progress
    DB-->>BE: Previous status
    BE->>DB: Upsert skill progress with max score and status
    alt First completed attempt
        BE->>DB: Update UserStats with lesson EXP
        BE->>DB: Complete matching DailyTasks and reward daily EXP
    else Already completed or still in progress
        BE->>BE: Skip duplicate lesson EXP
    end
    BE-->>FE: 200 progress saved and reward summary
    FE-->>Learner: Show completion result
    end
