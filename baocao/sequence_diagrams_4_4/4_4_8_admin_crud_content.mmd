%%{init: {"theme":"base","themeVariables":{"fontFamily":"Arial","fontSize":"22px","actorFontSize":"22px","messageFontSize":"20px","noteFontSize":"20px"},"sequence":{"actorMargin":110,"messageMargin":65,"diagramMarginX":45,"diagramMarginY":25}}}%%
sequenceDiagram
    autonumber
    actor Admin as Admin
    participant FE as React Frontend<br/>(Admin Pages)
    participant BE as Node.js/Express Backend<br/>(Admin Module)
    participant DB as PostgreSQL

    rect rgb(245, 248, 255)
    Note over Admin,DB: Phase 1 - Open Admin dashboard or management module
    Admin->>FE: Open Admin area
    FE->>BE: GET /api/v1/admin/dashboard/stats or module list
    BE->>BE: Verify JWT and require admin role
    alt Missing or invalid token
        BE-->>FE: 401 Unauthorized
        FE-->>Admin: Redirect to login
    else Role is not admin
        BE-->>FE: 403 Forbidden
        FE-->>Admin: Show permission error
    else Admin is valid
        alt Dashboard statistics
            BE->>DB: Count users, lessons, questions, payments, tasks, study time and EXP
            BE->>DB: Select top learners and seven day activity
            DB-->>BE: Dashboard data
            BE-->>FE: 200 stats and module summaries
        else Content list
            BE->>DB: Select lessons, questions, vocabulary, grammar or game rows
            DB-->>BE: Module data
            BE-->>FE: 200 list data
        else User list
            BE->>DB: Select users, filters, roles, plans and status stats
            DB-->>BE: User data
            BE-->>FE: 200 user list and stats
        end
        FE-->>Admin: Render table, form or chart
    end
    end

    rect rgb(248, 255, 246)
    Note over Admin,DB: Phase 2 - CRUD learning content
    Admin->>FE: Create, update or delete content
    FE->>BE: POST, PUT or DELETE /api/v1/admin/module
    BE->>BE: Verify admin role and validate payload
    alt Skill, grammar or vocabulary content
        BE->>BE: Map request to the correct table and columns
        BE->>DB: Insert, update or delete content rows
        DB-->>BE: Affected rows or created row
    else Game levels, game questions or placement questions
        BE->>DB: Insert, update or delete game management rows
        DB-->>BE: Operation result
    end
    alt Operation succeeds
        BE-->>FE: 200 or 201 success
        FE->>FE: Reload current list
        FE-->>Admin: Show updated data
    else Validation, foreign key or not found error
        BE-->>FE: 400, 404 or 500 error
        FE-->>Admin: Show operation error
    end
    end

    rect rgb(255, 250, 240)
    Note over Admin,DB: Phase 3 - Manage accounts
    Admin->>FE: Create admin, edit user plan, lock, unlock or delete account
    FE->>BE: POST, PUT or DELETE /api/v1/admin/users
    BE->>BE: Verify admin role and apply account rules
    alt Create admin account
        BE->>DB: Insert Users row with admin role and hashed password
    else Update learner account
        BE->>DB: Update username, email, plan or active state
    else Reset password
        BE->>DB: Update PasswordHash with bcrypt hash
    else Delete or lock account
        BE->>DB: Delete Users row or update IsActive
    end
    DB-->>BE: Operation result
    BE-->>FE: Success or error response
    FE->>FE: Reload admin and learner lists
    FE-->>Admin: Show updated account view
    end
