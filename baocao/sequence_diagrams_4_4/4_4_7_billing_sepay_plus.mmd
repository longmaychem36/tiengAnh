%%{init: {"theme":"base","themeVariables":{"fontFamily":"Arial","fontSize":"22px","actorFontSize":"22px","messageFontSize":"20px","noteFontSize":"20px"},"sequence":{"actorMargin":110,"messageMargin":65,"diagramMarginX":45,"diagramMarginY":25}}}%%
sequenceDiagram
    autonumber
    actor Learner as Learner
    participant FE as React Frontend<br/>(Billing/Profile)
    participant BE as Node.js/Express Backend<br/>(Billing Module)
    participant SePay as SePay Transactions API
    participant DB as PostgreSQL

    rect rgb(245, 248, 255)
    Note over Learner,DB: Phase 1 - Create Plus payment order
    Learner->>FE: Click Upgrade Plus
    FE->>BE: GET /api/v1/billing/subscription
    BE->>BE: Verify JWT and learner role
    BE->>DB: Select Plan and PlusExpiresAt
    DB-->>BE: Current subscription
    BE-->>FE: 200 subscription

    FE->>BE: POST /api/v1/billing/plus/orders
    BE->>DB: Ensure billing schema and PaymentRequests table
    BE->>DB: Select pending Plus payment for user
    alt Pending order exists
        DB-->>BE: Existing pending payment
        BE->>BE: Build QR URL from transfer content and amount
    else No pending order
        BE->>BE: Create unique transfer content
        BE->>DB: Insert pending PaymentRequests row
        DB-->>BE: New payment order
        BE->>BE: Build QR URL from transfer content and amount
    end
    BE-->>FE: 200 order, QR URL, bank info and subscription
    FE-->>Learner: Show transfer instructions and QR code
    end

    rect rgb(248, 255, 246)
    Note over Learner,SePay: Phase 2 - Poll status and reconcile with SePay
    loop While order is pending
        FE->>BE: GET /api/v1/billing/plus/orders/:id
        BE->>DB: Select PaymentRequests by order id and user id
        DB-->>BE: Payment order
        alt Order is not found
            BE-->>FE: 404 payment order not found
        else Order is already completed or closed
            BE->>DB: Select latest subscription
            BE-->>FE: 200 order status and subscription
        else Order is pending
            BE->>SePay: GET transaction list
            alt SePay fails or no matching transaction exists
                SePay--xBE: Error or unmatched transactions
                BE-->>FE: 200 pending order and current subscription
                FE-->>Learner: Keep polling
            else Matching transaction found
                SePay-->>BE: Matched transaction
                BE->>DB: Update Users to Plus and extend PlusExpiresAt
                BE->>DB: Mark PaymentRequests as completed
                DB-->>BE: Plus activation saved
                BE-->>FE: 200 completed order and Plus subscription
                FE-->>Learner: Unlock Plus features
            end
        end
    end
    end

    rect rgb(255, 250, 240)
    Note over SePay,BE: Current webhook only authenticates and acknowledges. Plus activation happens through polling reconciliation.
    SePay->>BE: POST /api/v1/billing/sepay/webhook
    BE->>BE: Validate webhook API key when configured
    alt API key is invalid
        BE-->>SePay: 401 invalid webhook API key
    else API key is valid
        BE->>BE: Log payload and acknowledge only
        BE-->>SePay: 200 success
    end
    end
