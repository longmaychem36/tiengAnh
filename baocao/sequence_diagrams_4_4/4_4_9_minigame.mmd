%%{init: {"theme":"base","themeVariables":{"fontFamily":"Arial","fontSize":"22px","actorFontSize":"22px","messageFontSize":"20px","noteFontSize":"20px"},"sequence":{"actorMargin":110,"messageMargin":65,"diagramMarginX":45,"diagramMarginY":25}}}%%
sequenceDiagram
    autonumber
    actor Learner as Learner
    participant FE as React Frontend<br/>(Mini-game)
    participant BE as Node.js/Express Backend<br/>(Game Module)
    participant DB as PostgreSQL

    rect rgb(245, 248, 255)
    Note over Learner,DB: Phase 1 - Load mini-game levels
    Learner->>FE: Open Mini-game
    FE->>BE: GET /api/v1/games/levels
    BE->>BE: Verify JWT and learner role
    BE->>DB: Select GameLevels and UserGameProgress
    DB-->>BE: Levels and progress
    BE->>BE: Calculate locked state from previous completed level
    BE-->>FE: 200 levels with stars and lock state
    FE-->>Learner: Show level map
    end

    rect rgb(248, 255, 246)
    Note over Learner,DB: Phase 2 - Load questions and play
    Learner->>FE: Select unlocked level
    FE->>BE: GET /api/v1/games/levels/:levelId/questions
    BE->>DB: Select GameLevels and MiniGameQuestions
    alt Level or questions are missing
        BE-->>FE: 404 or empty question set
        FE-->>Learner: Show loading error
    else Questions exist
        DB-->>BE: Level and questions
        BE->>BE: Shape questions and hide correct answers
        BE-->>FE: 200 level and questions
        loop Each question
            Learner->>FE: Answer matching, listening, sentence build, true false or speak repeat item
            FE->>FE: Store answer locally and play audio when needed
        end
    end
    end

    rect rgb(255, 250, 240)
    Note over Learner,DB: Phase 3 - Submit answers, calculate stars and reward progress
    Learner->>FE: Submit level result
    FE->>BE: POST /api/v1/games/submit
    BE->>DB: Load level and answer keys for submitted question ids
    BE->>BE: Grade answers, calculate score percentage and stars
    BE->>DB: Upsert UserGameProgress with score, stars and completion state
    alt Level is passed
        BE->>BE: Calculate EXP from level and score rules
        BE->>DB: Update UserStats with EXP, level, streak and achievements
    else Level is not passed
        BE->>BE: Set earned EXP to zero
    end
    BE->>DB: Complete matching DailyTasks and reward daily EXP
    DB-->>BE: Progress and reward updates
    BE-->>FE: 200 score, stars, pass state and EXP reward
    FE-->>Learner: Show result and unlock next level when passed
    end
