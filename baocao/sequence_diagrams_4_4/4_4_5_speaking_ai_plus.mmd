%%{init: {"theme":"base","themeVariables":{"fontFamily":"Arial","fontSize":"22px","actorFontSize":"22px","messageFontSize":"20px","noteFontSize":"20px"},"sequence":{"actorMargin":110,"messageMargin":65,"diagramMarginX":45,"diagramMarginY":25}}}%%
sequenceDiagram
    autonumber
    actor PlusUser as Plus Learner
    participant FE as React Frontend<br/>(Speaking AI Builder)
    participant BE as Node.js/Express Backend<br/>(Speaking AI Module)
    participant LLM as NVIDIA LLM API
    participant DB as PostgreSQL

    rect rgb(245, 248, 255)
    Note over PlusUser,DB: Phase 1 - Generate personalized Speaking lesson
    PlusUser->>FE: Enter topic, level, goal and question count
    FE->>BE: POST /api/v1/speaking/personalized
    BE->>BE: Verify JWT and learner role
    BE->>DB: Read Plan and PlusExpiresAt
    alt Account is not active Plus
        DB-->>BE: Free or expired plan
        BE-->>FE: 403 Speaking AI requires Plus
        FE-->>PlusUser: Show upgrade prompt
    else Account is active Plus
        DB-->>BE: Active Plus plan
        BE->>BE: Normalize request and check in-memory lesson cache
        alt Cache hit
            BE->>BE: Clone cached lesson
        else Cache miss
            BE->>LLM: POST chat completion with JSON lesson prompt
            alt NVIDIA fails or returns invalid JSON
                LLM--xBE: Error, timeout or invalid JSON
                BE->>LLM: Retry with stricter English-only instruction
            else NVIDIA returns valid lesson
                LLM-->>BE: JSON lesson
            end
            BE->>BE: Parse, validate and cache generated lesson
        end
        BE->>BE: Create temporary session with TTL and per-user limit
        BE-->>FE: 200 session id, lesson, sentences and expiration
        FE-->>PlusUser: Show generated lesson
    end
    end

    rect rgb(248, 255, 246)
    Note over PlusUser,DB: Phase 2 - Complete AI lesson and reward
    PlusUser->>FE: Finish generated lesson with average score
    FE->>BE: POST /api/v1/speaking/personalized/:sessionId/complete
    BE->>DB: Verify active Plus plan
    BE->>BE: Load in-memory session and calculate capped EXP
    alt Session missing, expired or already rewarded
        BE-->>FE: 404 expired or 200 already rewarded
    else Reward is allowed
        BE->>DB: Update UserStats with AI Speaking EXP
        BE->>DB: Complete matching DailyTasks when applicable
        DB-->>BE: Reward saved
        BE-->>FE: 200 completion result and reward summary
    end
    FE-->>PlusUser: Show score and earned EXP
    end
