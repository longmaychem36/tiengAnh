%%{init: {"theme":"base","themeVariables":{"fontFamily":"Arial","fontSize":"22px","actorFontSize":"22px","messageFontSize":"20px","noteFontSize":"20px"},"sequence":{"actorMargin":110,"messageMargin":65,"diagramMarginX":45,"diagramMarginY":25}}}%%
sequenceDiagram
    autonumber
    actor User as User
    participant FE as React Frontend<br/>(Login + AuthContext)
    participant BE as Node.js/Express Backend<br/>(Auth Module)
    participant DB as PostgreSQL

    rect rgb(245, 248, 255)
    Note over User,DB: Phase 1 - Email and password authentication
    User->>FE: Enter email and password
    FE->>BE: POST /api/v1/auth/login
    BE->>BE: Validate body, normalize email and prepare auth schemas
    BE->>DB: Select Users, LearningLevels and UserStats by email
    DB-->>BE: User row or empty result
    alt Invalid credentials
        BE->>BE: Reject missing user or failed bcrypt comparison
        BE-->>FE: 401 Unauthorized
        FE-->>User: Show login error
    else Valid credentials
        BE->>BE: Compare bcrypt hash and create JWT
        BE->>DB: Update LastLogin and StreakDays
        DB-->>BE: Login stats updated
        BE-->>FE: 200 user profile and token
        FE->>FE: Store token and authenticated user state
    end
    end

    rect rgb(248, 255, 246)
    Note over FE,DB: Phase 2 - Restore current session
    FE->>BE: GET /api/v1/auth/me with Bearer token
    BE->>BE: Verify JWT in authMiddleware
    alt Token is missing, expired or invalid
        BE-->>FE: 401 Unauthorized
        FE->>FE: Clear token and auth state
        FE-->>User: Redirect to login
    else Token is valid
        BE->>DB: Select current user, level and stats by user id
        DB-->>BE: Current profile
        BE-->>FE: 200 shaped user profile
        alt Role is admin
            FE-->>User: Redirect to Admin Dashboard
        else Role is learner
            FE-->>User: Redirect to Dashboard or Onboarding
        end
    end
    end
